# ── TOUTES CES CLÉS SONT OPTIONNELLES ──────────────────────────────
# Sans aucune clé, l'application fonctionne en MODE GRATUIT :
#   - Textes  : Pollinations.ai (gratuit, sans inscription)
#   - Images  : Pollinations.ai (gratuit, sans inscription)
#   - Vidéos  : indisponibles (aucune API vidéo gratuite fiable n'existe)

# Optionnel — meilleure qualité de textes avec Claude — https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...

# Optionnel — meilleure qualité d'images (FLUX) + active les vidéos (WAN)
# https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_...

# Studio Couture (page /couture) — Nano Banana de Google.
# Clé gratuite (quota gratuit) sur https://aistudio.google.com/apikey
# GOOGLE_API_KEY=AIza...
# (Optionnel) choisir le modèle image : gemini-2.5-flash-image (défaut) ou gemini-3-pro-image-preview
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ══════════════════════════════════════════════════════════════════════════
# Pack de skills Arcads (voir ARCADS-SKILL-PACK.md) — OPTIONNEL
# Rien de tout cela n'est nécessaire à l'application Next.js.
# Les valeurs contenant des caractères spéciaux ({, [, *, …) DOIVENT être
# entre guillemets simples.
# ══════════════════════════════════════════════════════════════════════════

# ── Option A (recommandée) : en-tête Basic déjà encodé ──────────────────────
# Dans votre tableau de bord Arcads (Settings > API). Ressemble à :
#   Basic ODQxMTg4NDExZDY1NDQ0MmJk...
# ARCADS_BASIC_AUTH='Basic your_base64_encoded_credentials_here'

# ── Option B : clé d'API seule ──────────────────────────────────────────────
# Utilisée comme nom d'utilisateur Basic avec un mot de passe vide. Certains
# comptes reçoivent un 403 ainsi — dans ce cas, utilisez l'option A.
# ARCADS_API_KEY=your_key_here

# ── Optionnel ───────────────────────────────────────────────────────────────
# ARCADS_CLIENT_ID=your_client_id_here
# ARCADS_BASE_URL=https://external-api.arcads.ai

# ── Meta Ads (skill meta-ad-builder — OPTIONNEL) ────────────────────────────
# Publication des créas via l'API Marketing de Meta. Chaque publicité créée par
# le skill est EN PAUSE : vous la lancez vous-même dans Ads Manager.
# Le token doit avoir le scope ads_management.
# META_ACCESS_TOKEN=your_long_lived_token_here
# META_AD_ACCOUNT_ID=act_1234567890
# META_PAGE_ID=
# META_IG_USER_ID=
# META_PIXEL_ID=
# META_API_VERSION=v23.0
