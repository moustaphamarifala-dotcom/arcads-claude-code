  "captions": [
    {"start": 0.3, "end": 6.6, "text": "À trois jours du mariage de sa sœur, Aïcha n'avait toujours pas trouvé son Bazin."},
    {"start": 6.6, "end": 13.4, "text": "Elle avait fait trois boutiques. Des couleurs ternes, une qualité qui ne tenait pas la lumière."},
    {"start": 13.4, "end": 20.2, "text": "Une amie lui a parlé de Bazin Mari Falah. Elle a failli ne pas y croire."},
    {"start": 20.2, "end": 27.4, "text": "Dès qu'elle a touché le tissu, elle a su. Ce bleu, ce rouge, cette brillance... c'était celui-là."},
    {"start": 27.4, "end": 33.3, "text": "Le jour du mariage, tout le monde lui a demandé où elle l'avait trouvé."},
    {"start": 33.3, "end": 37.5, "text": "Chez Bazin Mari Falah. Le vrai Bazin, celui qu'on remarque."}
  ]
}
